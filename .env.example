# Dev uses Vite proxy by default: browser → /api/v1 + /storage → Laravel (VITE_DEV_API_PROXY).
# Defaults live in `.env.development` (committed); override locally with `.env.development.local`.
# Optional absolute API URL is IGNORED in dev unless you set VITE_API_FULL_URL=1.
#
# VITE_API_FULL_URL=1
# VITE_API_URL=http://127.0.0.1:9000

VITE_API_URL=http://192.168.102.113:8000/

# Laravel base for proxy (php artisan serve default):
# VITE_DEV_API_PROXY=http://127.0.0.1:8000
#
# Dev UI port (vite.config strictPort — change if 5275 is taken):
# VITE_DEV_PORT=5275

# Google Sign-In (Web client ID — match backend GOOGLE_CLIENT_ID)
# VITE_GOOGLE_CLIENT_ID=

# Payments: return URLs may include ?payment=success|fail|cancel|callback&payment_pid=<uuid>.
# Stub completion calls the Laravel API (see backend PAYMENTS_STUB_FALLBACK); production uses real gateways only.
